{
  "name": "vovo-hero-video",
  "private": true,
  "version": "1.0.0",
  "description": "VOVO Agent AI — hero background video (Remotion). Renders are copied into ../public/video and never touch the Next.js build.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:desktop": "remotion render src/index.ts HeroDesktop out/hero-desktop.mp4 --codec=h264 --crf=23",
    "render:desktop-webm": "remotion render src/index.ts HeroDesktop out/hero-desktop.webm --codec=vp9 --crf=36",
    "render:mobile": "remotion render src/index.ts HeroMobile out/hero-mobile.mp4 --codec=h264 --crf=27",
    "render:mobile-webm": "remotion render src/index.ts HeroMobile out/hero-mobile.webm --codec=vp9 --crf=40",
    "still:desktop": "remotion still src/index.ts HeroDesktop out/hero-desktop-poster.jpeg --frame=0 --image-format=jpeg --jpeg-quality=82",
    "still:mobile": "remotion still src/index.ts HeroMobile out/hero-mobile-poster.jpeg --frame=0 --image-format=jpeg --jpeg-quality=82"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.300",
    "@remotion/google-fonts": "^4.0.300",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.300"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
